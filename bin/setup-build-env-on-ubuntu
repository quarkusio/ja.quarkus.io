#!/usr/bin/env bash
set -eu

#
# This script installs build tools for the localization project.
# It is primarily intended for use on GitHub Actions (Ubuntu Server).
#

SCRIPT_DIR=$(cd $(dirname $0); pwd)
L10N_HOME=$(cd $(dirname $SCRIPT_DIR); pwd)
cd $L10N_HOME

# --- Core Build Tools ---
# - git: version control
# - git-restore-mtime: improves build speed by restoring original timestamps
# - maven: required for ROQ site building
sudo apt-get -y install git git-restore-mtime maven

# --- Localization Tools ---
# - po4a: converts between AsciiDoc and PO files
# - gettext: provides msgcat for PO file normalization
sudo apt-get -y install po4a gettext

# --- Deployment & Preview ---
# - nodejs: runtime for JavaScript tools
# - surge: static hosting service for Pull Request previews
sudo apt-get -y install nodejs
sudo npm --global install surge
