#. type: Content of: <div><div><div><h2>
#: templates/partials/homepage-developer_joy-band.html:4
msgid "Developer Joy"
msgstr "開発者満足"

#. type: Content of: <div><div><div><p>
#: templates/partials/homepage-developer_joy-band.html:8
msgid "A cohesive platform for optimized developer joy:"
msgstr "開発者満足のために最適化され、一貫したプラットフォーム:"

#. type: Content of: <div><div><div><p><ul><li>
#: templates/partials/homepage-developer_joy-band.html:10
msgid "Unified configuration"
msgstr "統一された設定"

#. type: Content of: <div><div><div><p><ul><li>
#: templates/partials/homepage-developer_joy-band.html:11
msgid "Zero config, live reload in the blink of an eye"
msgstr "ゼロコンフィグ、瞬く間のライブリロード"

#. type: Content of: <div><div><div><p><ul><li>
#: templates/partials/homepage-developer_joy-band.html:12
msgid "Streamlined code for the 80% common usages, flexible for the 20%"
msgstr "80%の一般的な用途には合理的なコード、20%の用途には柔軟なコード"

#. type: Content of: <div><div><div><p><ul><li>
#: templates/partials/homepage-developer_joy-band.html:13
msgid "No hassle native executable generation"
msgstr "容易なネイティブ実行可能ファイル生成"

#. type: Content of: <div><div><div><div><div><pre>
#: templates/partials/homepage-developer_joy-band.html:20
#, no-wrap
msgid ""
"<code class=\"bash\">$ mvn package -Pnative\n"
"\n"
"  # Or\n"
"\n"
"$ gradle build -Dquarkus.package.type=native</code>"
msgstr ""

