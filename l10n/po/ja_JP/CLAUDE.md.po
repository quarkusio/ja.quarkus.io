#. type: Title ##
#: CLAUDE.md:13
#, no-wrap
msgid "Project Structure"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`content/posts/` — Blog posts (`.adoc`, `.asciidoc`, or `.md` with `YYYY-MM-DD-slug` naming)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`content/` — Site pages (`.md` or `.adoc`)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`content/_generated-doc/` — Guides synced from the main Quarkus repo (do not edit here)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`templates/` — Qute layout templates (`layouts/`) and partials (`partials/`)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`_data/` — YAML data files (`authors.yaml`, `siteConfig.yml`, events, books)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`web/` — SCSS stylesheets and static assets\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`public/` — Static assets (images, JavaScript, fonts)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`config/application.properties` — Main Roq/Quarkus configuration\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`config/application-noguides.properties` — Profile that excludes guides for fast builds\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`config/application-only-latest-guides.properties` — Profile with only latest guides\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`src/` — Java source (Roq extensions, site configuration beans) and tests\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:27
#, no-wrap
msgid "`pom.xml` — Maven build descriptor\n"
msgstr ""

#. type: Title ##
#: CLAUDE.md:28
#, no-wrap
msgid "Running Locally"
msgstr ""

#. type: Fenced code block (sh)
#: CLAUDE.md:30
#, no-wrap
msgid ""
"./serve.sh                     # full site (includes guides)\n"
"./serve-noguides.sh            # fast startup, no guides\n"
"./serve-only-latest-guides.sh  # only latest + main guides\n"
msgstr ""

#. type: Plain text
#: CLAUDE.md:37
#, no-wrap
msgid "Requires Java 21+. Site is served at http://localhost:8080.\n"
msgstr ""

#. type: Title ##
#: CLAUDE.md:38
#, no-wrap
msgid "Running Tests"
msgstr ""

#. type: Fenced code block (sh)
#: CLAUDE.md:40
#, no-wrap
msgid "./mvnw test\n"
msgstr ""

#. type: Title ##
#: CLAUDE.md:44
#, no-wrap
msgid "Blog Post Conventions"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:51
#, no-wrap
msgid "Location: `content/posts/YYYY-MM-DD-slug.adoc` (date must match front matter `date`)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:51
#, no-wrap
msgid "Front matter: `layout: post`, `title`, `date`, `tags`, `synopsis`, `author`\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:51
#, no-wrap
msgid "Author must be defined in `_data/authors.yaml`\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:51
#, no-wrap
msgid "Tags: lowercase, space-separated\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:51
#, no-wrap
msgid "Permalink pattern: `/blog/:Name/` (configured in `config/application.properties`)\n"
msgstr ""

#. type: Bullet: '- '
#: CLAUDE.md:51
#, no-wrap
msgid "Images: store in `assets/images/posts/<slug>/`, reference with `:imagesdir:`\n"
msgstr ""
