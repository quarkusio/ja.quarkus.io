#. type: Hash Value: jobs check-links steps run
#: .github/workflows/check-external-links.yml:1
#, no-wrap
msgid ""
"if [ -f target/broken-links.json ]; then\n"
"  REPORTABLE=$(jq '.summary.reportableCount' target/broken-links.json)\n"
"  UNCHECKABLE=$(jq '.summary.uncheckableCount' target/broken-links.json)\n"
"  OLD_CONTENT=$(jq '.summary.oldContentCount' target/broken-links.json)\n"
"  TOTAL=$(jq '.summary.totalBrokenLinks' target/broken-links.json)\n"
"  echo \"## $TOTAL Broken Links Found\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  echo \"- **$REPORTABLE** reportable (will raise defects)\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  echo \"- **$UNCHECKABLE** uncheckable (401/403/410 - informational only)\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  echo \"- **$OLD_CONTENT** in old content (blogs/newsletters older than cutoff - informational only)\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  if [ \"$REPORTABLE\" -gt 0 ]; then\n"
"    echo \"### Reportable Broken Links (will raise defects)\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"| URL | Status | Found On |\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"|-----|--------|----------|\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    jq -r '.reportable[] | \"| \\(.url) | \\(.status) \\(.statusText) | \\(.referrer) |\"' target/broken-links.json >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  fi\n"
"  if [ \"$UNCHECKABLE\" -gt 0 ]; then\n"
"    echo \"### Uncheckable Links (informational only)\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"These links return 401/403/410 status codes - often due to bot blocking or paywalls.\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"| URL | Status | Found On |\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"|-----|--------|----------|\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    jq -r '.uncheckable[] | \"| \\(.url) | \\(.status) \\(.statusText) | \\(.referrer) |\"' target/broken-links.json >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  fi\n"
"  if [ \"$OLD_CONTENT\" -gt 0 ]; then\n"
"    echo \"### Links in Old Content (informational only)\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"These broken links are from blogs and newsletters older than the configured cutoff.\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"| URL | Status | Found On |\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"|-----|--------|----------|\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"    jq -r '.oldContent[] | \"| \\(.url) | \\(.status) \\(.statusText) | \\(.referrer) |\"' target/broken-links.json >> \"$GITHUB_STEP_SUMMARY\"\n"
"    echo \"\" >> \"$GITHUB_STEP_SUMMARY\"\n"
"  fi\n"
"  echo \"\"\n"
"  echo \"=== Broken Links Report ===\"\n"
"  if [ \"$REPORTABLE\" -gt 0 ]; then\n"
"    echo \"\"\n"
"    echo \"REPORTABLE ($REPORTABLE links - will raise defects):\"\n"
"    jq -r '.reportable[] | \"\\(.status) \\(.url)\\n       linked from: \\(.referrer)\\n\"' target/broken-links.json\n"
"  fi\n"
"  if [ \"$UNCHECKABLE\" -gt 0 ]; then\n"
"    echo \"\"\n"
"    echo \"UNCHECKABLE ($UNCHECKABLE links - informational only):\"\n"
"    jq -r '.uncheckable[] | \"\\(.status) \\(.url)\\n       linked from: \\(.referrer)\\n\"' target/broken-links.json\n"
"  fi\n"
"  if [ \"$OLD_CONTENT\" -gt 0 ]; then\n"
"    echo \"\"\n"
"    echo \"OLD CONTENT ($OLD_CONTENT links - informational only):\"\n"
"    jq -r '.oldContent[] | \"\\(.status) \\(.url)\\n       linked from: \\(.referrer)\\n\"' target/broken-links.json\n"
"  fi\n"
"  echo \"=== End of Report ===\"\n"
"  echo \"\"\n"
"  echo \"Total: $TOTAL broken link(s) ($REPORTABLE reportable, $UNCHECKABLE uncheckable, $OLD_CONTENT in old content)\"\n"
"else\n"
"  echo \"No results file found — crawler may not have completed.\"\n"
"fi\n"
msgstr ""

