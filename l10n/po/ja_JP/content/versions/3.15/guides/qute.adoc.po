msgstr ""

msgid "The matched input is the template path that starts with a template root, and the `/` is used as a path separator. For example, `templates/foo.html`."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_QUTE_DEV_MODE_NO_RESTART_TEMPLATES+++[]"
