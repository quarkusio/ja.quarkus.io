msgid "Note that the `quarkus.qute.property-not-found-strategy` config property is completely ignored if strict rendering is enabled."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_QUTE_STRICT_RENDERING+++[]"
msgstr ""

