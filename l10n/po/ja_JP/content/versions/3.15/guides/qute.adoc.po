"icon:lock[title=Fixed at build time] [[quarkus-qute_quarkus-qute-template-path-exclude]] [.property-path]##link:#quarkus-qute_quarkus-qute-template-path-exclude[`quarkus.qute.template-path-exclude`]##\n"
"\n"
"[.description]\n"
"--\n"
"This regular expression is used to exclude template files from the `templates` directory. Excluded templates are neither parsed nor validated during build and are not available at runtime.\n"
"\n"
"The matched input is the file path relative from the `templates` directory and the `/` is used as a path separator.\n"
"\n"
"By default, the hidden files are excluded. The name of a hidden file starts with a dot.\n"
"\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_QUTE_TEMPLATE_PATH_EXCLUDE+++[]\n"
"--"
msgstr ""

msgid "icon:lock[title=Fixed at build time] [[quarkus-qute_quarkus-qute-template-path-exclude]] [.property-path]##link:#quarkus-qute_quarkus-qute-template-path-exclude[`quarkus.qute.template-path-exclude`]##"
msgstr ""

msgid "This regular expression is used to exclude template files from the `templates` directory. Excluded templates are neither parsed nor validated during build and are not available at runtime."
msgstr ""

msgid "The matched input is the file path relative from the `templates` directory and the `/` is used as a path separator."
msgstr ""

msgid "By default, the hidden files are excluded. The name of a hidden file starts with a dot."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_QUTE_TEMPLATE_PATH_EXCLUDE+++[]"
msgstr ""

