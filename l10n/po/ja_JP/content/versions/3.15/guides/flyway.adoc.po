msgstr ""

msgid "Locations starting with filesystem: point to a directory on the filesystem, may only contain SQL migrations and are only scanned recursively down non-hidden directories."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_FLYWAY_LOCATIONS+++[]"
msgstr ""

