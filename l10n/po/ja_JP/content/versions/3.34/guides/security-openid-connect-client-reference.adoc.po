"[[quarkus-oidc-client_quarkus-oidc-client-refresh-interval]] [.property-path]##link:#quarkus-oidc-client_quarkus-oidc-client-refresh-interval[`+++quarkus.oidc-client.refresh-interval+++`]##\n"
