"config_property_copy_button:+++quarkus.management.proxy.trusted-proxies+++[]"
msgstr ""

msgid "Configure the list of trusted proxy addresses. Received `Forwarded`, `X-Forwarded` or `X-Forwarded-++*++` headers from any other proxy address will be ignored. The trusted proxy address should be specified as the IP address (IPv4 or IPv6), hostname or Classless Inter-Domain Routing (CIDR) notation. Please note that Quarkus needs to perform DNS lookup for all hostnames during the request. For that reason, using hostnames is not recommended."
msgstr ""

msgid "Examples of a socket address in the form of `host` or `host:port`:"
msgstr ""

msgid "`127.0.0.1:8084`"
msgstr ""

msgid "`++[++0:0:0:0:0:0:0:1++]++`"
msgstr ""

msgid "`++[++0:0:0:0:0:0:0:1++]++:8084`"
msgstr ""

msgid "`++[++::++]++`"
msgstr ""

msgid "`localhost`"
msgstr "`localhost`"

msgid "`localhost:8084`"
msgstr ""

msgid "Examples of a CIDR notation:"
msgstr ""

msgid "`::/128`"
msgstr ""

msgid "`::/0`"
msgstr ""

msgid "`127.0.0.0/8`"
msgstr ""

msgid "Please bear in mind that IPv4 CIDR won't match request sent from the IPv6 address and the other way around."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_MANAGEMENT_PROXY_TRUSTED_PROXIES+++[]"
msgstr ""

msgid "list of TrustedProxyCheckPart"
msgstr ""

msgid "`+++All proxy addresses are trusted+++`"
