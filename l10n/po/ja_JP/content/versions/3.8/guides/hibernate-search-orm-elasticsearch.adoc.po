msgstr ""

msgid "`link:#quarkus-hibernate-search-orm-outboxpolling_quarkus-hibernate-search-orm-coordination-event-processor-enabled[quarkus.hibernate-search-orm.\"persistence-unit-name\".coordination.event-processor.enabled]`"
msgstr ""

msgid ""
"Whether the event processor is enabled,\n"
"i.e. whether events will be processed to perform automatic reindexing on this instance of the application."
msgstr ""

