msgstr ""

msgid "tooltip:fast-jar[The \"fast JAR\" packaging type.], tooltip:uber-jar[The \"Uber-JAR\" packaging type.], tooltip:mutable-jar[The \"mutable JAR\" packaging type (for remote development mode).], tooltip:legacy-jar[The \"legacy JAR\" packaging type. This corresponds to the packaging type used in Quarkus before version 1.12.]"
