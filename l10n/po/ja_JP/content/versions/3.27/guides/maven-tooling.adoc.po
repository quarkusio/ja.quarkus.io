msgstr ""

msgid ""
"icon:lock[title=Fixed at build time] [[quarkus-core_quarkus-package-jar-type]] [.property-path]##link:#quarkus-core_quarkus-package-jar-type[`quarkus.package.jar.type`]##\n"
"config_property_copy_button:+++quarkus.package.jar.type+++[]"
msgstr ""

