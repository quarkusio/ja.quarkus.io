msgstr ""

msgid "Container sharing is only used in dev mode."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_INFINISPAN_CLIENT_DEVSERVICES_SHARED+++[]"
msgstr ""

msgid ""
"icon:lock[title=Fixed at build time] [[quarkus-infinispan-client_quarkus-infinispan-client-devservices_quarkus-infinispan-client-devservices-service-name]] [.property-path]##link:#quarkus-infinispan-client_quarkus-infinispan-client-devservices_quarkus-infinispan-client-devservices-service-name[`quarkus.infinispan-client.devservices.service-name`]##\n"
