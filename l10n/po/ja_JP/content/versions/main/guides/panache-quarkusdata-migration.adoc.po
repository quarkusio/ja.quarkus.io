msgstr ""

msgid "The same method."
msgstr ""

msgid "`firstResultOptional()`, `singleResultOptional()`, `count()`"
msgstr ""

msgid "The same method; `count()` returns `Long` instead of `long`."
msgstr ""

msgid "`project(Dto.class)`"
msgstr ""

msgid "The same method. Existing Panache projection annotations remain applicable."
