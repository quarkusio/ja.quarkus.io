msgstr ""

msgid "Type"
msgstr "タイプ"

msgid "Default"
msgstr "デフォルト"

msgid ""
"icon:lock[title=Fixed at build time] [[quarkus-elytron-security-"
"oauth2_quarkus-oauth2-enabled]] [.property-path]##link:#quarkus-elytron-"
"security-oauth2_quarkus-oauth2-enabled[`+++quarkus.oauth2.enabled+++`]##\n"
"config_property_copy_button:+++quarkus.oauth2.enabled+++[]\n"
"\n"
"\n"
