msgid "Incoming Attributes of the 'smallrye-kafka' connector"
msgstr ""

msgid "Attribute (_alias_)"
msgstr ""

msgid "Description"
msgstr ""

msgid "Mandatory"
msgstr ""

msgid "Default"
msgstr ""

msgid ""
"[.no-hyphens]#*bootstrap.servers*#\n"
"\n"
"[.no-hyphens]#_(kafka.bootstrap.servers)_#"
msgstr ""

msgid ""
"A comma-separated list of host:port to use for establishing the initial "
"connection to the Kafka cluster.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "false"
msgstr ""

msgid "`localhost:9092`"
msgstr ""

msgid "[.no-hyphens]#*topic*#"
msgstr ""

msgid ""
"The consumed / populated Kafka topic. If neither this property nor the "
"`topics` properties are set, the channel name is used\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*health-enabled*#"
msgstr ""

msgid ""
"Whether health reporting is enabled (default) or disabled\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "`true`"
msgstr ""

msgid "[.no-hyphens]#*health-readiness-enabled*#"
msgstr ""

msgid ""
"Whether readiness health reporting is enabled (default) or disabled\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*health-readiness-topic-verification*#"
msgstr ""

msgid ""
"_deprecated_ - Whether the readiness check should verify that topics exist "
"on the broker. Default to false. Enabling it requires an admin connection. "
"Deprecated: Use 'health-topic-verification-enabled' instead.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*health-readiness-timeout*#"
msgstr ""

msgid ""
"_deprecated_ - During the readiness health check, the connector connects to "
"the broker and retrieves the list of topics. This attribute specifies the "
"maximum duration (in ms) for the retrieval. If exceeded, the channel is "
"considered not-ready. Deprecated: Use 'health-topic-verification-timeout' "
"instead.\n"
"\n"
"Type: _long_"
msgstr ""

msgid "[.no-hyphens]#*health-topic-verification-enabled*#"
msgstr ""

msgid ""
"Whether the startup and readiness check should verify that topics exist on "
"the broker. Default to false. Enabling it requires an admin client "
"connection.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "`false`"
msgstr ""

msgid "[.no-hyphens]#*health-topic-verification-readiness-disabled*#"
msgstr ""

msgid ""
"Whether the topic verification is disabled for the readiness health check.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*health-topic-verification-startup-disabled*#"
msgstr ""

msgid ""
"Whether the topic verification is disabled for the startup health check.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*health-topic-verification-timeout*#"
msgstr ""

msgid ""
"During the startup and readiness health check, the connector connects to the "
"broker and retrieves the list of topics. This attribute specifies the "
"maximum duration (in ms) for the retrieval. If exceeded, the channel is "
"considered not-ready.\n"
"\n"
"Type: _long_"
msgstr ""

msgid "`2000`"
msgstr ""

msgid "[.no-hyphens]#*tracing-enabled*#"
msgstr ""

msgid "Whether tracing is enabled (default) or disabled\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*client-id-prefix*#"
msgstr ""

msgid ""
"Prefix for Kafka client `client.id` attribute. If defined configured or "
"generated `client.id` will be prefixed with the given value.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*checkpoint.state-store*#"
msgstr ""

msgid ""
"While using the `checkpoint` commit-strategy, the name set in `@Identifier` "
"of a bean that implements `io.smallrye.reactive.messaging.kafka.StateStore."
"Factory` to specify the state store implementation.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*checkpoint.state-type*#"
msgstr ""

msgid ""
"While using the `checkpoint` commit-strategy, the fully qualified type name "
"of the state object to persist in the state store. When provided, it can be "
"used by the state store implementation to help persisting the processing "
"state object.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*checkpoint.unsynced-state-max-age.ms*#"
msgstr ""

msgid ""
"While using the `checkpoint` commit-strategy, specify the max age in "
"milliseconds that the processing state must be persisted before the "
"connector is marked as unhealthy. Setting this attribute to 0 disables this "
"monitoring.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`10000`"
msgstr ""

msgid "[.no-hyphens]#*cloud-events*#"
msgstr ""

msgid ""
"Enables (default) or disables the Cloud Event support. If enabled on an "
"_incoming_ channel, the connector analyzes the incoming records and try to "
"create Cloud Event metadata. If enabled on an _outgoing_, the connector "
"sends the outgoing messages as Cloud Event if the message includes Cloud "
"Event Metadata.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*kafka-configuration*#"
msgstr ""

msgid ""
"Identifier of a CDI bean that provides the default Kafka consumer/producer "
"configuration for this channel. The channel configuration can still override "
"any attribute. The bean must have a type of Map<String, Object> and must use "
"the @io.smallrye.common.annotation.Identifier qualifier to set the "
"identifier.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*topics*#"
msgstr ""

msgid ""
"A comma-separated list of topics to be consumed. Cannot be used with the "
"`topic` or `pattern` properties\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*pattern*#"
msgstr ""

msgid ""
"Indicate that the `topic` property is a regular expression. Must be used "
"with the `topic` property. Cannot be used with the `topics` property\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*assign-seek*#"
msgstr ""

msgid ""
"Assign partitions and optionally seek to offsets, instead of subscribing to "
"topics. A comma-separating list of triplets in form of `<topic>:"
"|<partition>|:<offset>` to assign statically to the consumer and seek to the "
"given offsets. Offset `0` seeks to beginning and offset `-1` seeks to the "
"end of the topic-partition. If the topic is omitted the configured topic "
"will be used. If the offset is omitted partitions are assigned to the "
"consumer but won't be seeked to offset.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*key.deserializer*#"
msgstr ""

msgid ""
"The deserializer classname used to deserialize the record's key\n"
"\n"
"Type: _string_"
msgstr ""

msgid "`org.apache.kafka.common.serialization.StringDeserializer`"
msgstr ""

msgid "[.no-hyphens]#*lazy-client*#"
msgstr ""

msgid "Whether Kafka client is created lazily or eagerly.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*value.deserializer*#"
msgstr ""

msgid ""
"The deserializer classname used to deserialize the record's value\n"
"\n"
"Type: _string_"
msgstr ""

msgid "true"
msgstr ""

msgid "[.no-hyphens]#*fetch.min.bytes*#"
msgstr ""

msgid ""
"The minimum amount of data the server should return for a fetch request. The "
"default setting of 1 byte means that fetch requests are answered as soon as "
"a single byte of data is available or the fetch request times out waiting "
"for data to arrive.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`1`"
msgstr ""

msgid "[.no-hyphens]#*group.id*#"
msgstr ""

msgid ""
"A unique string that identifies the consumer group the application belongs "
"to.\n"
"\n"
"If not set, defaults to the application name as set by the `quarkus."
"application.name` configuration property.\n"
"\n"
"If that is not set either, a unique, generated id is used.\n"
"\n"
"It is recommended to always define a `group.id`, the automatic generation is "
"only a convenient feature for development.\n"
"You can explicitly ask for automatically generated unique id by setting this "
"property to `${quarkus.uuid}`.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*enable.auto.commit*#"
msgstr ""

msgid ""
"If enabled, consumer's offset will be periodically committed in the "
"background by the underlying Kafka client, ignoring the actual processing "
"outcome of the records. It is recommended to NOT enable this setting and let "
"Reactive Messaging handles the commit.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*retry*#"
msgstr ""

msgid ""
"Whether or not the connection to the broker is re-attempted in case of "
"failure\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*retry-attempts*#"
msgstr ""

msgid ""
"The maximum number of reconnection before failing. -1 means infinite retry\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`-1`"
msgstr ""

msgid "[.no-hyphens]#*retry-max-wait*#"
msgstr ""

msgid "The max delay (in seconds) between 2 reconnects\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`30`"
msgstr ""

msgid "[.no-hyphens]#*broadcast*#"
msgstr ""

msgid ""
"Whether the Kafka records should be dispatched to multiple consumer\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*auto.offset.reset*#"
msgstr ""

msgid ""
"What to do when there is no initial offset in Kafka.Accepted values are "
"earliest, latest and none\n"
"\n"
"Type: _string_"
msgstr ""

msgid "`latest`"
msgstr ""

msgid "[.no-hyphens]#*failure-strategy*#"
msgstr ""

msgid ""
"Specify the failure strategy to apply when a message produced from a record "
"is acknowledged negatively (nack). Values can be `fail` (default), `ignore`, "
"`dead-letter-queue`, or `delayed-retry-topic`\n"
"\n"
"Type: _string_"
msgstr ""

msgid "`fail`"
msgstr ""

msgid "[.no-hyphens]#*commit-strategy*#"
msgstr ""

msgid ""
"Specify the commit strategy to apply when a message produced from a record "
"is acknowledged. Values can be `latest`, `ignore` or `throttled`. If `enable."
"auto.commit` is true then the default is `ignore` otherwise it is "
"`throttled`\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*ordered*#"
msgstr ""

msgid ""
"Configures ordering guarantees for concurrent processing. Possible values: "
"`key` for per-key sequential processing, or `partition` for per-partition "
"sequential processing. Requires `@Blocking(ordered = false)` for concurrency."
" Works with any commit strategy.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*ordered.max-concurrency*#"
msgstr ""

msgid ""
"Maximum number of groups (keys or partitions) that can be processed "
"concurrently. Defaults to `max.poll.records`.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "[.no-hyphens]#*throttled.unprocessed-record-max-age.ms*#"
msgstr ""

msgid ""
"While using the `throttled` commit-strategy, specify the max age in "
"milliseconds that an unprocessed message can be before the connector is "
"marked as unhealthy. Setting this attribute to 0 disables this monitoring.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`60000`"
msgstr ""

msgid "[.no-hyphens]#*dead-letter-queue.topic*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `dead-letter-queue` indicates on which "
"topic the record is sent. Defaults is `dead-letter-topic-$channel`\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*dead-letter-queue.producer-client-id*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `dead-letter-queue` indicates what "
"client id the generated producer should use. Defaults is `kafka-dead-letter-"
"topic-producer-$client-id`\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*dead-letter-queue.key.serializer*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `dead-letter-queue` indicates the key "
"serializer to use. If not set the serializer associated to the key "
"deserializer is used\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*dead-letter-queue.value.serializer*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `dead-letter-queue` indicates the "
"value serializer to use. If not set the serializer associated to the value "
"deserializer is used\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*delayed-retry-topic.topics*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `delayed-retry-topic` indicates topics "
"to use. If not set the source channel name is used, with 10, 20 and 50 "
"seconds delayed topics.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*delayed-retry-topic.max-retries*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `delayed-retry-topic` indicates the "
"maximum number of retries. If higher than the number of delayed retry "
"topics, last topic is used.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "[.no-hyphens]#*delayed-retry-topic.timeout*#"
msgstr ""

msgid ""
"When the `failure-strategy` is set to `delayed-retry-topic` indicates the "
"global timeout per record.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`120000`"
msgstr ""

msgid "[.no-hyphens]#*partitions*#"
msgstr ""

msgid ""
"_deprecated_ - The number of partitions to be consumed concurrently. The "
"connector creates the specified amount of Kafka consumers. It should match "
"the number of partition of the targeted topic. Deprecated: Use `concurrency` "
"channel attribute instead.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "[.no-hyphens]#*requests*#"
msgstr ""

msgid ""
"_deprecated_ - When `partitions` is greater than 1, this attribute allows "
"configuring how many records are requested by each consumers every time. "
"Deprecated: Use `concurrency` channel attribute instead.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`128`"
msgstr ""

msgid "[.no-hyphens]#*consumer-rebalance-listener.name*#"
msgstr ""

msgid ""
"The name set in `@Identifier` of a bean that implements `io.smallrye."
"reactive.messaging.kafka.KafkaConsumerRebalanceListener`. If set, this "
"rebalance listener is applied to the consumer.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*key-deserialization-failure-handler*#"
msgstr ""

msgid ""
"The name set in `@Identifier` of a bean that implements `io.smallrye."
"reactive.messaging.kafka.DeserializationFailureHandler`. If set, "
"deserialization failure happening when deserializing keys are delegated to "
"this handler which may retry or provide a fallback value.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*value-deserialization-failure-handler*#"
msgstr ""

msgid ""
"The name set in `@Identifier` of a bean that implements `io.smallrye."
"reactive.messaging.kafka.DeserializationFailureHandler`. If set, "
"deserialization failure happening when deserializing values are delegated to "
"this handler which may retry or provide a fallback value.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*fail-on-deserialization-failure*#"
msgstr ""

msgid ""
"When no deserialization failure handler is set and a deserialization failure "
"happens, report the failure and mark the application as unhealthy. If set to "
"`false` and a deserialization failure happens, a `null` value is forwarded.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*graceful-shutdown*#"
msgstr ""

msgid ""
"Whether or not a graceful shutdown should be attempted when the application "
"terminates.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*poll-timeout*#"
msgstr ""

msgid ""
"The polling timeout in milliseconds. When polling records, the poll will "
"wait at most that duration before returning records. Default is 1000ms\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`1000`"
msgstr ""

msgid "[.no-hyphens]#*pause-if-no-requests*#"
msgstr ""

msgid ""
"Whether the polling must be paused when the application does not request "
"items and resume when it does. This allows implementing back-pressure based "
"on the application capacity. Note that polling is not stopped, but will not "
"retrieve any records when paused.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*batch*#"
msgstr ""

msgid ""
"Whether the Kafka records are consumed in batch. The channel injection point "
"must consume a compatible type, such as `List<Payload>` or "
"`KafkaRecordBatch<Payload>`.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*max-queue-size-factor*#"
msgstr ""

msgid ""
"Multiplier factor to determine maximum number of records queued for "
"processing, using `max.poll.records` * `max-queue-size-factor`. Defaults to "
"2. In `batch` mode `max.poll.records` is considered `1`.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "`2`"
msgstr ""

msgid "[.no-hyphens]#*share-group*#"
msgstr ""

msgid ""
"Whether to use Kafka Share Groups for consumption. When enabled, the "
"consumer will use a ShareConsumer which provides cooperative record "
"processing across multiple consumers without explicit partition assignment.\n"
"\n"
"Type: _boolean_"
msgstr ""

msgid "[.no-hyphens]#*share-group.failure-acknowledgement-type*#"
msgstr ""

msgid ""
"Default acknowledgement type to apply to the record, when the message is "
"nacked.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "`release`"
msgstr ""

msgid ""
"[.no-hyphens]#*share-group.failure-deserialization-acknowledgement-type*#"
msgstr ""

msgid ""
"Default acknowledgement type to apply to the record, when the message is "
"nacked because of failure on deserialization.\n"
"\n"
"Type: _string_"
msgstr ""

msgid "`reject`"
msgstr ""

msgid "[.no-hyphens]#*share-group.unprocessed-record-max-age.ms*#"
msgstr ""

msgid ""
"While using share groups, specify the max age in milliseconds that an "
"unprocessed record can be before the connector reports a failure. Setting "
"this attribute to 0 disables this monitoring.\n"
"\n"
"Type: _int_"
msgstr ""

msgid "Outgoing channel configuration (writing to Kafka)"
msgstr ""

msgid ""
"You can also pass any property supported by the underlying https://kafka."
"apache.org/documentation/#producerconfigs[Kafka producer]."
msgstr ""

msgid "For example, to configure the `max.block.ms` property, use:"
msgstr ""

msgid ""
"Some producer client properties are configured to sensible default values:"
msgstr ""

msgid ""
"If not set, `key.serializer` is set to `org.apache.kafka.common."
"serialization.StringSerializer`."
msgstr ""

msgid ""
"If not set, producer `client.id` is generated as `[client-id-prefix][channel-"
"name]`."
msgstr ""

msgid "Outgoing Attributes of the 'smallrye-kafka' connector"
msgstr ""

msgid "[.no-hyphens]#*acks*#"
msgstr ""

msgid ""
"The number of acknowledgments the producer requires the leader to have "
"received before considering a request complete. This controls the durability "
