msgid "Plugging in converters and entity listeners"
msgstr ""

msgid ""
"The Quarkus extension for Hibernate ORM supports injecting link:{hibernate-"
"orm-docs-url}#basic-jpa-convert[attribute converters] and link:{hibernate-"
"orm-docs-url}#events-jpa-callbacks[entity listeners] into Hibernate ORM."
