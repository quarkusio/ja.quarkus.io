msgid ""
"A comma-separated list of routing keys to bind the queue to the exchange\n"
"\n"
"Type: _string_"
msgstr ""

msgid "`#`"
msgstr ""

msgid "[.no-hyphens]#*content-type-override*#"
msgstr ""

msgid ""
"Override the content_type attribute of the incoming message, should be a "
"valid MIME type\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*max-outstanding-messages*#"
msgstr ""

msgid ""
"The maximum number of outstanding/unacknowledged messages being processed by "
"the connector at a time; must be a positive number\n"
"\n"
"Type: _int_"
msgstr ""

msgid "Outgoing channel configuration"
msgstr ""

msgid "[.no-hyphens]#*default-routing-key*#"
msgstr ""

msgid ""
"The default routing key to use when sending messages to the exchange\n"
"\n"
"Type: _string_"
msgstr ""

msgid "[.no-hyphens]#*default-ttl*#"
msgstr ""

msgid ""
"If specified, the time (ms) sent messages can remain in queues undelivered "
"before they are dead\n"
"\n"
"Type: _long_"
msgstr ""

msgid "[.no-hyphens]#*max-inflight-messages*#"
msgstr ""

msgid ""
"The maximum number of messages to be written to RabbitMQ concurrently; must "
"be a positive number\n"
"\n"
"Type: _long_"
msgstr ""

msgid "`1024`"
msgstr ""

msgid "[.no-hyphens]#*max-outgoing-internal-queue-size*#"
msgstr ""

msgid "The maximum size of the outgoing internal queue\n"
"\n"
"Type: _int_"
msgstr ""
