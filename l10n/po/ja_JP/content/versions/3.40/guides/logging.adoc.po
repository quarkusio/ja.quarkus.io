msgid "Service configuration information."
msgstr "サービス設定情報。"

msgid "FINE"
msgstr "FINE"

msgid "Same as **DEBUG**."
msgstr "**DEBUG** と同じ。"

msgid "FINER"
msgstr "FINER"

msgid "Same as **TRACE**."
msgstr "**TRACE** と同じ。"

msgid "FINEST"
msgstr "FINEST"

msgid "Increased debug output compared to `TRACE`, which might have a higher frequency."
msgstr "`TRACE` よりも詳細なデバッグ出力。さらに高頻度になる可能性があります。"

msgid "The mapping between the levels"
