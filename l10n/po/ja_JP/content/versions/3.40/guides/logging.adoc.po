msgstr ""

msgid "Numerical level value"
msgstr ""

msgid "Standard level name"
msgstr ""

msgid "Equivalent `java.util.logging` (JUL) level name"
msgstr ""

msgid "1100"
msgstr ""

msgid "Not applicable"
msgstr ""

msgid "1000"
msgstr ""

msgid "900"
msgstr ""

msgid "800"
msgstr ""

msgid "700"
msgstr ""

msgid "500"
msgstr ""

msgid "400"
msgstr ""

msgid "300"
