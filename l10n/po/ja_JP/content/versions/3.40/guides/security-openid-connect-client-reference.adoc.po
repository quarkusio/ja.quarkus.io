msgid ""
"These grants are `refresh_token` (with the external refresh token), "
"`authorization_code`, and two grants which can be used to exchange the "
"current access token, namely:"
msgstr ""

msgid "`urn:ietf:params:oauth:grant-type:token-exchange`"
msgstr ""

msgid "`urn:ietf:params:oauth:grant-type:jwt-bearer`."
msgstr ""

