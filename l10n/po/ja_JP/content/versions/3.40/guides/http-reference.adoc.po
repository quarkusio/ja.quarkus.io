msgstr ""

msgid "`Integer.MIN_VALUE + 2`"
msgstr ""

msgid "`ROUTE_ORDER_CORS_MANAGEMENT`"
msgstr "`ROUTE_ORDER_CORS_MANAGEMENT`"

msgid "CORS-Origin handler of the management router."
msgstr "マネジメントルーターの CORS-Origin ハンドラー。"

msgid "`Integer.MIN_VALUE + 3`"
msgstr ""

msgid "`ROUTE_ORDER_BODY_HANDLER_MANAGEMENT`"
msgstr "`ROUTE_ORDER_BODY_HANDLER_MANAGEMENT`"

msgid "Body handler for the management router."
msgstr "マネジメントルーターのボディハンドラー。"

msgid "`ROUTE_ORDER_BODY_HANDLER`"
msgstr "`ROUTE_ORDER_BODY_HANDLER`"

