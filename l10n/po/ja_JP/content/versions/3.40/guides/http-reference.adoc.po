msgstr "開始時間を追加するハンドラー (設定で有効な場合)。"

msgid "`ROUTE_ORDER_HOT_REPLACEMENT`"
msgstr "`ROUTE_ORDER_HOT_REPLACEMENT`"

msgid "-replacement body handler."
msgstr "ホットリプレイスメントのボディハンドラー。"

msgid "`ROUTE_ORDER_HEADERS`"
msgstr "`ROUTE_ORDER_HEADERS`"

msgid "Handlers that add headers specified in the configuration."
msgstr "設定で指定されたヘッダーを追加するハンドラー。"

msgid "`Integer.MIN_VALUE + 1`"
msgstr "`Integer.MIN_VALUE + 1`"

msgid "`ROUTE_ORDER_HOST_VALIDATION_MANAGEMENT`"
msgstr ""

