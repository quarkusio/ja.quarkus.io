msgstr ""

msgid "Match classes with package `org.acme`"
msgstr ""

msgid "`org.acme.**`"
msgstr ""

msgid "Match classes where the package starts with `org.acme`"
msgstr ""

msgid "`Bar`"
msgstr ""

msgid "Match the simple name of the class"
msgstr ""

msgid "Exclude the type `org.acme.Foo`."
msgstr ""

