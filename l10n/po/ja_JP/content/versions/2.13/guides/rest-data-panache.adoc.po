msgid "MongoDB"
msgstr "MongoDB"

msgid "MongoDB REST Data with Panache extension (`quarkus-mongodb-rest-data-panache`)"
msgstr "MongoDB REST Data with Panache エクステンション ( `quarkus-mongodb-rest-data-panache` )"

