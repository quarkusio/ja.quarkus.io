msgid "README: Quarkus documentation"
msgstr "README: Quarkus ドキュメント"

msgid "Quarkus documentation uses asciidoc syntax."
msgstr "Quarkusのドキュメントでは、asciidoc構文が使用されています。"

msgid "A gradual refactoring effort is underway to reshape Quarkus documentation to make it easier to both read and write (see xref:doc-concepts.adoc[Quarkus documentation concepts] for more on this transition)."
msgstr "Quarkusのドキュメントを読みやすく、書きやすくするために、段階的なリファクタリングが行われています（この移行については、 link:doc-concepts.html[Quarkusドキュメントのコンセプト] を参照してください）。"

msgid "For more information on contributing to Quarkus docs, see:"
msgstr "Quarkusのドキュメントへの貢献について詳しくはこちらをご覧ください:"

msgid "xref:doc-contribute-docs-howto.adoc[How to contribute documentation]"
msgstr "link:doc-contribute-docs-howto.html[Quarkusのドキュメントに貢献]"

msgid "xref:doc-concepts.adoc[Quarkus documentation concepts]"
msgstr "xref:doc-concepts.adoc[Quarkusドキュメントのコンセプト]"

msgid "xref:doc-reference.adoc[Quarkus documentation reference]"
msgstr "xref:doc-reference.adoc[Quarkusドキュメントリファレンス]"

msgid "Glossary"
msgstr "用語集"

msgid ""
"This is a collection of preferred term in the documentation and website.\n"
"Please stay within these terms for consistency."
msgstr "ドキュメントやウェブサイトで好まれる用語を集めたものです。一貫性を保つために、これらの用語の範囲内にとどめてください。"

msgid "Live coding:: for our `quarkus:dev` capability"
msgstr "Live coding:: `quarkus:dev` 機能について"

msgid "GraalVM native image:: preferred term for the VM creating native executable. No space."
msgstr "GraalVM native image:: ネイティブ実行可能ファイルを作成するためのVMを表す好ましい用語。スペースなし"

msgid "Substrate VM:: non-preferred. Exclude."
msgstr "Substrate VM:: 非推奨。除外。"

msgid "Native Executable:: the executable that is compiled to native 1s and 0s"
msgstr "Native Executable:: ネイティブの1と0にコンパイルされる実行可能ファイル"

msgid "Docker image:: for the actual `Dockerfile` definition and when the tool chain is involved"
msgstr "Docker image:: 実際の `Dockerfile` 定義とツールチェーンが関連する場合"

msgid "Container:: when we discuss Quarkus running in... containers"
msgstr "Container:: コンテナ内で実行されるQuarkusについて説明する場合"

msgid "Supersonic Subatomic Java:: our tagline"
msgstr "Supersonic Subatomic Java:: 私達のキャッチフレーズ"

msgid "Kubernetes Native Java:: our preferred tagline to say that we rock for containers"
msgstr "Kubernetes Native Java:: コンテナを支持するという私達の推奨キャッチフレーズ"

msgid "Developer Joy:: for everything going from live reload to the opinionated layer to a single config file"
msgstr "Developer Joy:: ライブリロードから独自のレ​​イヤー、単一の設定ファイルに至るまでのすべてをサポート"

msgid "Unify Imperative and Reactive:: imperative and reactive. 'Nuff said."
msgstr "Unify Imperative and Reactive:: 命令型とリアクティブ型。言わずもがなでしょう"

msgid "Best of breed frameworks and standards:: when we explain our stack"
msgstr "Best of breed frameworks and standards:: スタックを説明するとき"
