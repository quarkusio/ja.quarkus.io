msgid "quarkus:build"
msgstr ""

msgid "Builds the Quarkus application."
msgstr ""

msgid "[[quarkus-maven-plugin-goal-build-parameter-parameter]]link:#quarkus-maven-plugin-goal-build-parameter-parameter[Parameter]"
