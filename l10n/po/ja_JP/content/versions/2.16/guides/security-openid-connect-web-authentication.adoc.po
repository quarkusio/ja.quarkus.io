"\n"
"[.description]\n"
"--\n"
"Additional properties which will be added as the query parameters to the logout redirect URI.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__LOGOUT_EXTRA_PARAMS+++[]\n"
"--"
msgstr ""

msgid "[[quarkus-oidc_quarkus.oidc.-tenant-.logout.extra-params-extra-params]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.logout.extra-params-extra-params[quarkus.oidc.\"tenant\".logout.extra-params]`"
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__LOGOUT_EXTRA_PARAMS+++[]"
msgstr ""

