msgstr "`quarkus-reactive-db2-client`"

msgid "`io.vertx.mutiny.db2client.DB2Pool`"
msgstr "`io.vertx.mutiny.db2client.DB2Pool`"

msgid "`?`"
msgstr "`?`"

