msgid ""
"[[quarkus-vertx-http-config-group-cors-cors-config_quarkus.http.cors.origins]]`link:#quarkus-vertx-http-config-group-cors-cors-config_quarkus.http.cors.origins[quarkus.http.cors.origins]`\n"
