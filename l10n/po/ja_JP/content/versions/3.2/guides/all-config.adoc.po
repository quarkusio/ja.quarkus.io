"--"
msgstr "`link:#quarkus-hibernate-search-orm-coordination-outbox-polling_quarkus.hibernate-search-orm.coordination.event-processor.pulse-expiration[quarkus.hibernate-search-orm.coordination.event-processor.pulse-expiration]`"

