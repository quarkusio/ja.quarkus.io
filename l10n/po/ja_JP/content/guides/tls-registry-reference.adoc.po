"config_property_copy_button:+++quarkus.tls.\"tls-bucket-name\".pqc-enforcement-policy+++[]"
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_TLS__TLS_BUCKET_NAME__PQC_ENFORCEMENT_POLICY+++[]"
