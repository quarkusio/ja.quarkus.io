"[[quarkus-tls-registry_quarkus-tls-trust-store-credentials-provider-name]] [.property-path]##link:#quarkus-tls-registry_quarkus-tls-trust-store-credentials-provider-name[`+++quarkus.tls.trust-store.credentials-provider.name+++`]##\n"
