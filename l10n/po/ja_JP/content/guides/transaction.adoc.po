"cancel-wait-period+++`]##\n"
"config_property_copy_button:+++quarkus.transaction-manager.reaper.cancel-"
"wait-period+++[]"
msgstr ""

msgid ""
"The time the reaper waits before interrupting a cancel worker that is "
"rolling back a timed-out transaction."
msgstr ""

msgid ""
"When a transaction exceeds its timeout, the reaper schedules a cancel and "
"waits this period before interrupting the cancel worker. In CPU-constrained "
"environments (e.g., containers with strict CPU limits), the default of 500ms "
"may be too aggressive, causing premature zombie transaction declarations."
msgstr ""

msgid ""
"Environment variable: env_var_with_copy_button:"
"+++QUARKUS_TRANSACTION_MANAGER_REAPER_CANCEL_WAIT_PERIOD+++[]"
msgstr ""

msgid "`+++500MS+++`"
msgstr ""

msgid ""
"[[quarkus-narayana-jta_quarkus-transaction-manager-reaper-cancel-fail-wait-"
"period]] [.property-path]##link:#quarkus-narayana-jta_quarkus-transaction-"
"manager-reaper-cancel-fail-wait-period[`+++quarkus.transaction-manager."
"reaper.cancel-fail-wait-period+++`]##\n"
"config_property_copy_button:+++quarkus.transaction-manager.reaper.cancel-"
"fail-wait-period+++[]\n"
"\n"
"\n"
"[.description]\n"
"--\n"
"The time the reaper waits after interrupting a cancel worker before "
"declaring the transaction a zombie.\n"
"\n"
"After interrupting a cancel worker, the reaper waits this period. If the "
"worker has not completed by then, the transaction is marked as a zombie. In "
"CPU-constrained environments, increasing this value gives the application "
"thread more time to respond to the cancellation.\n"
"\n"
"\n"
"Environment variable: env_var_with_copy_button:"
"+++QUARKUS_TRANSACTION_MANAGER_REAPER_CANCEL_FAIL_WAIT_PERIOD+++[]\n"
"--"
msgstr ""

