msgstr "現在、クライアントは以下のパラメーターキーをサポートしています。"

msgid "`user`"
msgstr "`user`"

msgid "`password`"
msgstr "`password`"

msgid "`sqlserver://[user[:[password]]@]host[:port][/database][?<key1>=<value1>[&<key2>=<value2>]]`"
