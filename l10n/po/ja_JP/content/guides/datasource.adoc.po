msgstr "`db2://[user[:[password]]@]host[:port][/database][?<key1>=<value1>[&<key2>=<value2>]]`"

msgid "`db2://dbuser:secretpassword@database.server.com:50000/mydb`"
msgstr "`db2://dbuser:secretpassword@database.server.com:50000/mydb`"

